module.exports = [
  {
    id: 1,
    imgIcon: "/img/svg/wildfire.svg",
    title: (
      <>
        KALM — Mental Health <br /> RAG Chatbot
      </>
    ),
    imageCredit: null,
    popupImg: "/img/portfolio/kalm.png",
    popupTitle: "KALM: Knowledge-Augmented Language Model for Mental Health",
    firstDescriptionText: (
      <>
        <p>
          Production-grade RAG chatbot delivering empathetic, evidence-based
          mental health support to construction workers using a 5-stage ALGEE
          therapeutic framework.
        </p>
      </>
    ),
    serviceListDescriptions: (
      <>
        <h3>Description</h3>
        <p>
          KALM combines <strong>GPT-4.1</strong>, <strong>ChromaDB</strong>,
          and <strong>FastAPI</strong> to deliver contextually grounded
          therapeutic conversations. It uses a Retrieval-Augmented Generation
          pipeline over 1,000+ clinical knowledge chunks with real-time crisis
          detection.
        </p>

        <h3>Data &amp; Tools</h3>
        <p>
          Stack: FastAPI, GPT-4.1, ChromaDB, LangChain, AES-128 encryption.
          <br />
          Data: 1,000+ clinical knowledge chunks, 53 crisis signal patterns.
        </p>

        <h3>Approach</h3>
        <p>
          • Engineered 5-stage ALGEE therapeutic framework with 4 distinct AI
          personas.
          <br />• Real-time crisis detection across 53 signal patterns with
          automatic escalation.
          <br />• AES-128 encrypted session storage for HIPAA-aligned data
          handling.
          <br />• Multi-turn context management with ChromaDB vector similarity
          search.
        </p>

        <h3>Results</h3>
        <p>
          • Sub-2s response latency with streaming output.
          <br />• 1,000+ knowledge chunks indexed with 95%+ retrieval
          relevance.
          <br />• End-to-end encrypted sessions with zero data leakage.
        </p>

        <h3>Impact</h3>
        <p>
          Demonstrates how LLM-powered RAG systems can deliver safe, scalable
          mental health support in high-risk occupational settings.
        </p>

        <h3>Links</h3>
        <p>
          Live:{" "}
          <a
            href="https://kalm-omega.vercel.app/"
            target="_blank"
            rel="noreferrer"
          >
            kalm-omega.vercel.app
          </a>
          {" | "}
          GitHub:{" "}
          <a
            href="https://github.com/pTidke/kalm-rag"
            target="_blank"
            rel="noreferrer"
          >
            github.com/pTidke/kalm-rag
          </a>
        </p>
      </>
    ),
  },
  {
    id: 2,
    imgIcon: "/img/svg/wildfire.svg",
    title: (
      <>
        AllAboutTax — <br /> AI Tax Advisory
      </>
    ),
    imageCredit: null,
    popupImg: "/img/portfolio/allabouttax.png",
    popupTitle: "AllAboutTax: AI-Powered Tax Advisory Platform",
    firstDescriptionText: (
      <>
        <p>
          Full-stack AI tax advisory platform combining a CMS-driven content
          engine with intelligent document processing for personalized tax
          guidance.
        </p>
      </>
    ),
    serviceListDescriptions: (
      <>
        <h3>Description</h3>
        <p>
          AllAboutTax is a production <strong>Next.js 14</strong> application
          with <strong>Sanity Studio CMS</strong> that provides AI-powered tax
          planning and advisory services. It features real-time document
          analysis and personalized recommendation engines.
        </p>

        <h3>Data &amp; Tools</h3>
        <p>
          Stack: Next.js 14, Sanity Studio, Tailwind CSS, Vercel Edge
          Functions.
          <br />
          Features: SSR/ISR rendering, GROQ queries, structured content
          modeling.
        </p>

        <h3>Approach</h3>
        <p>
          • Headless CMS architecture with Sanity Studio for real-time content
          management.
          <br />• Server-side rendering with incremental static regeneration
          for SEO optimization.
          <br />• Modular component library with 15+ reusable UI blocks.
          <br />• Edge-deployed API routes for sub-100ms response times.
        </p>

        <h3>Results</h3>
        <p>
          • 95+ Lighthouse performance score across all pages.
          <br />• Real-time CMS updates with zero-downtime deployments.
          <br />• Full mobile responsiveness with accessible UI patterns.
        </p>

        <h3>Impact</h3>
        <p>
          Provides accessible, AI-augmented tax guidance that scales content
          delivery through a modern headless architecture.
        </p>

        <h3>Links</h3>
        <p>
          Live:{" "}
          <a
            href="https://www.allabouttax.in/"
            target="_blank"
            rel="noreferrer"
          >
            www.allabouttax.in
          </a>
        </p>
      </>
